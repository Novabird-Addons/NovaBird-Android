<?xml version="1.0" encoding="utf-8"?>
<!-- Send button in the compose screen: the send icon on an accent pill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimary" />
            <corners android:radius="18dp" />
            <size android:width="56dp" android:height="36dp" />
        </shape>
    </item>
    <item
        android:width="20dp"
        android:height="20dp"
        android:gravity="center"
        android:drawable="@drawable/nb_ic_send_on_primary" />
</layer-list>
