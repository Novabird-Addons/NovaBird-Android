<?xml version="1.0" encoding="utf-8"?>
<!-- NovaBird block at the top of the settings: semantic search with the Helper status, and sender logos.
     Content of SettingsHeaderView; the rows look like text_icon_list_item. -->
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout"
    >

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="24dp"
        android:paddingTop="12dp"
        android:paddingRight="24dp"
        android:paddingBottom="8dp"
        android:singleLine="true"
        android:text="@string/brand_name"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        />

    <LinearLayout
        android:id="@+id/nb_search_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/nb_settings_block_margin"
        android:background="?attr/colorSurfaceContainerLow"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        >

        <ImageView
            android:id="@+id/nb_search_status_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            android:padding="4dp"
            app:srcCompat="@drawable/nb_ic_sparkle"
            app:tint="?attr/colorOnSurfaceVariant"
            />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="0dp"
            android:paddingBottom="8dp"
            >

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nb_search_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/novabird_settings_search_local_now"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/nb_status_warn"
                android:visibility="gone"
                />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/novabird_shortcut_ai_short"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nb_search_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Helper verbunden: PC"
                />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/nb_settings_block_margin"
        android:background="?android:attr/windowBackground"
        />

    <LinearLayout
        android:id="@+id/nb_sync_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/nb_settings_block_margin"
        android:background="?attr/colorSurfaceContainerLow"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        >

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/nb_settings_icon_tile"
            android:importantForAccessibility="no"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_download"
            app:tint="?attr/colorOnPrimaryContainer"
            />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            >

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/novabird_shortcut_sync_limits_short"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/novabird_settings_sync_limits_note"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/nb_settings_block_margin"
        android:background="?android:attr/windowBackground"
        />

    <LinearLayout
        android:id="@+id/nb_protect_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/nb_settings_block_margin"
        android:background="?attr/colorSurfaceContainerLow"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        >

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/nb_settings_icon_tile"
            android:importantForAccessibility="no"
            android:padding="8dp"
            app:srcCompat="@drawable/nb_ic_shield_alert"
            app:tint="?attr/colorOnPrimaryContainer"
            />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            >

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/novabird_settings_protect"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nb_protect_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Aus"
                />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/nb_settings_block_margin"
        android:background="?android:attr/windowBackground"
        />

    <LinearLayout
        android:id="@+id/nb_logo_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/nb_settings_block_margin"
        android:background="?attr/colorSurfaceContainerLow"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        >

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/nb_settings_icon_tile"
            android:importantForAccessibility="no"
            android:padding="8dp"
            app:srcCompat="@drawable/nb_ic_logo"
            app:tint="?attr/colorOnPrimaryContainer"
            />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            >

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/novabird_settings_logos"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/novabird_settings_logos_note"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/nb_logo_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            />
    </LinearLayout>
</merge>
