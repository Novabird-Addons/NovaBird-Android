<?xml version="1.0" encoding="utf-8"?>
<!-- NovaBird: warning banner of the phishing protection above an opened message (ProtectionMessageViewHook).
     Colors are set in code per level: "Vorsicht" amber, "gefährlich" error colors, "Prüfung nicht möglich" grey. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nb_protect_box"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/nb_protection_banner_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        >

        <ImageView
            android:id="@+id/nb_protect_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/nb_ic_shield_alert"
            />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            >

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nb_protect_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                tools:text="Vorsicht: Diese Mail hat Merkmale von Phishing."
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nb_protect_score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                tools:text="Bewertung: 45 von 100"
                />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nb_protect_reasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingTop="6dp"
        android:paddingEnd="0dp"
        android:visibility="gone"
        tools:visibility="visible"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/nb_protect_links"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="34dp"
        android:paddingTop="4dp"
        android:paddingEnd="0dp"
        android:text="@string/novabird_protect_banner_links"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone"
        tools:visibility="visible"
        />

    <LinearLayout
        android:id="@+id/nb_protect_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="0dp"
        >

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/nb_protect_why"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:minHeight="40dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:text="@string/novabird_protect_banner_why"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/nb_protect_trust"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:minHeight="40dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:text="@string/novabird_protect_banner_trust"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/nb_protect_blocked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:text="@string/novabird_protect_trust_blocked"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone"
            />
    </LinearLayout>
</LinearLayout>
