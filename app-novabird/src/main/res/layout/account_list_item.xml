<?xml version="1.0" encoding="utf-8"?>
<!-- NovaBird: Thunderbird's account_list_item as a row of a white block with the mail icon on a round tile. Keep the
     ids (name, email, drag_handle) in sync with legacy/ui/legacy/src/main/res/layout/account_list_item.xml. -->
<com.fsck.k9.view.DraggableFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/windowBackground"
    android:stateListAnimator="@animator/draggable_state_list_anim"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/nb_settings_block_margin"
        android:background="?attr/colorSurfaceContainerLow"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="0dp"
        >

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/nb_settings_account_tile"
            android:contentDescription="@string/account_settings_action"
            android:padding="9dp"
            app:tint="?attr/colorOnPrimary"
            app:srcCompat="@drawable/ic_mail"
            />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            >

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fadeScrollbars="true"
                android:paddingTop="8dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Personal"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:paddingBottom="8dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="test@example.org"
                />

        </LinearLayout>

        <ImageView
            android:id="@+id/drag_handle"
            android:layout_width="48dp"
            android:scaleType="center"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="14dp"
            app:tint="?attr/colorOutline"
            app:srcCompat="@drawable/ic_drag_handle"
            />

    </LinearLayout>

</com.fsck.k9.view.DraggableFrameLayout>
