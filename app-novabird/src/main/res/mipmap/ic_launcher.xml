<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon for Android versions before 8.0 (no adaptive icons) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/launcher_icon_background" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_app_logo"
        android:bottom="10dp"
        android:left="10dp"
        android:right="10dp"
        android:top="10dp"
        />
</layer-list>
