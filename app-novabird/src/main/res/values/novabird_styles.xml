<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.NovaBird.Toolbar" parent="Widget.App.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextAppearance">@style/TextAppearance.NovaBird.ToolbarTitle</item>
    </style>

    <style name="TextAppearance.NovaBird.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.NovaBird.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.NovaBird.Fab</item>
    </style>

    <style name="ShapeAppearance.NovaBird.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
</resources>
