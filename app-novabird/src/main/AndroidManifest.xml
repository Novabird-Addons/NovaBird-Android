<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto"
    >

    <application
        android:name=".NovaBirdApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.NovaBird.Startup"
        >

        <!-- Long-press shortcut on the launcher icon to open the NovaBird sync limits -->
        <activity
            android:name="net.thunderbird.app.common.MainActivity"
            tools:node="merge"
            >
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/novabird_shortcuts"
                />
        </activity>

        <!-- NovaBird search replaces the K-9 search results screen. The search field of the message list starts
             com.fsck.k9.activity.MessageSearchActivity explicitly; the alias with that name opens the NovaBird search
             instead, so no upstream code needs to change. -->
        <activity
            android:name="com.fsck.k9.activity.MessageSearchActivity"
            tools:node="remove"
            />

        <activity
            android:name="org.novabird.mail.search.NovaBirdSearchActivity"
            android:exported="false"
            android:label="@string/search_action"
            android:windowSoftInputMode="adjustResize"
            />

        <activity-alias
            android:name="com.fsck.k9.activity.MessageSearchActivity"
            android:exported="false"
            android:targetActivity="org.novabird.mail.search.NovaBirdSearchActivity"
            />

        <activity
            android:name="com.fsck.k9.ui.settings.account.OpenPgpAppSelectDialog"
            android:configChanges="locale"
            android:theme="@style/Theme.NovaBird.DayNight.Dialog.Translucent"
            />

        <activity
            android:name="com.fsck.k9.ui.notification.DeleteConfirmationActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.NovaBird.DayNight.Dialog.Translucent"
            />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge"
            >

            <!-- We're using on-demand initialization for WorkManager -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove"
                />

        </provider>

        <!-- This component is disabled by default (if possible). It will be enabled programmatically if necessary. -->
        <receiver
            android:name="org.novabird.mail.widget.provider.MessageListWidgetProvider"
            android:icon="@drawable/message_list_widget_preview"
            android:label="@string/message_list_widget_label"
            android:enabled="@bool/home_screen_widgets_enabled"
            android:exported="false"
            >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/message_list_widget_info"
                />
        </receiver>

        <!-- This component is disabled by default (if possible). It will be enabled programmatically if necessary. -->
        <receiver
            android:name="org.novabird.mail.widget.provider.UnreadWidgetProvider"
            android:label="@string/unread_widget_label"
            android:enabled="@bool/home_screen_widgets_enabled"
            android:exported="false"
            >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/unread_widget_info"
                />
        </receiver>

    </application>
</manifest>
