    <string name="novabird_sync_full_title">Load all messages</string>
    <string name="novabird_sync_full_description">Loads all messages of this account in one go, with the period and number of messages from the account settings. Only on Wi-Fi.</string>
    <string name="novabird_sync_full_note">Runs with a notification, also with the screen off. If Wi-Fi goes away, it continues later on its own. Android allows this for about 6 hours a day; if it is not done by then, just start it again.</string>
