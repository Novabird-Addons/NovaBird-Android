    <string name="novabird_sync_full_title">Alle Mails abrufen</string>
    <string name="novabird_sync_full_description">Lädt alle Mails dieses Kontos am Stück, mit Zeitraum und Anzahl aus den Kontoeinstellungen. Nur im WLAN.</string>
    <string name="novabird_sync_full_note">Läuft mit einer Benachrichtigung, auch bei ausgeschaltetem Display. Fällt das WLAN weg, geht es später von selbst weiter. Android erlaubt das etwa 6 Stunden am Tag; ist es bis dahin nicht fertig, einfach noch einmal starten.</string>
    <string name="novabird_sync_full_start">Jetzt alle Mails abrufen</string>
    <string name="novabird_sync_full_stop">Stopp</string>
