<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- exported like the sync settings, so the launcher shortcut can open it; it takes no extras -->
        <activity
            android:name="org.novabird.feature.ai.ui.AiSettingsActivity"
            android:exported="true"
            android:label="@string/novabird_ai_settings_title"
            android:windowSoftInputMode="adjustResize"
            />

        <activity
            android:name="org.novabird.feature.ai.ui.AiMailActivity"
            android:exported="false"
            android:label="@string/novabird_ai_mail_title"
            />

        <activity
            android:name="org.novabird.feature.ai.ui.AiNewsActivity"
            android:exported="false"
            android:label="@string/novabird_ai_news_title"
            />

    </application>
</manifest>
